{
 "about": "R-5 prompt conformance cases (tools/v41/template_conformance.py). messages/tools/kwargs are what transformers' apply_chat_template takes (tool call arguments as objects); request = the extra fields of the same conversation as an OpenAI Chat Completions request to our server; anthropic = the same conversation as an Anthropic Messages request; encoder/serve false = that rendering is not compared; known = a rendering that differs from DeepSeek's template on purpose, with the reason.",
 "cases": [
  {"name": "single user, thinking (default effort high = 75)",
   "messages": [{"role": "user", "content": "Hello"}],
   "anthropic": {"messages": [{"role": "user", "content": "Hello"}]}},

  {"name": "system + user, thinking",
   "messages": [{"role": "system", "content": "You are terse."}, {"role": "user", "content": "What is 2+2?"}],
   "anthropic": {"system": "You are terse.", "messages": [{"role": "user", "content": "What is 2+2?"}]}},

  {"name": "thinking off (chat mode)",
   "messages": [{"role": "system", "content": "You are terse."}, {"role": "user", "content": "What is 2+2?"}],
   "kwargs": {"thinking_mode": "chat"},
   "request": {"chat_template_kwargs": {"enable_thinking": false}},
   "anthropic": {"system": "You are terse.", "messages": [{"role": "user", "content": "What is 2+2?"}],
                 "thinking": {"type": "disabled"}}},

  {"name": "reasoning_effort none = thinking off",
   "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "none"},
   "request": {"reasoning_effort": "none"},
   "encoder": false},

  {"name": "multi-turn, thinking: earlier reasoning dropped",
   "messages": [{"role": "system", "content": "Be brief."},
                {"role": "user", "content": "Name a prime."},
                {"role": "assistant", "content": "7", "reasoning_content": "Any prime works; 7."},
                {"role": "user", "content": "Another one."}],
   "anthropic": {"system": "Be brief.", "messages": [
                {"role": "user", "content": "Name a prime."},
                {"role": "assistant", "content": [{"type": "thinking", "thinking": "Any prime works; 7.", "signature": "x"},
                                                  {"type": "text", "text": "7"}]},
                {"role": "user", "content": "Another one."}]}},

  {"name": "multi-turn, chat mode with reasoning in history",
   "messages": [{"role": "user", "content": "Name a prime."},
                {"role": "assistant", "content": "7", "reasoning_content": "Any prime works; 7."},
                {"role": "user", "content": "Another one."}],
   "kwargs": {"thinking_mode": "chat"},
   "request": {"reasoning_effort": "none"}},

  {"name": "multi-turn ending on the assistant (no generation prompt either way)",
   "messages": [{"role": "user", "content": "Say hi."},
                {"role": "assistant", "content": "Hi!", "reasoning_content": "Greet."}],
   "known": {"serve": "11-15: the server continues a trailing assistant message (prefill: the encoder's wo_eos, no end token), as Anthropic's and DeepSeek's APIs do; the template has no prefill and closes it. Exact shape: test_serve_ds41.py t_prefill"}},

  {"name": "tools + call + result + answer (tools keep all reasoning)",
   "messages": [{"role": "system", "content": "You can read files."},
                {"role": "user", "content": "What is in a.txt?"},
                {"role": "assistant", "content": "", "reasoning_content": "Read it.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "read_file", "arguments": {"path": "a.txt", "lines": 3}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "AAA\nBBB"},
                {"role": "assistant", "content": "It holds AAA and BBB.", "reasoning_content": "Got it."},
                {"role": "user", "content": "Thanks. And b.txt?"}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "lines": {"type": "integer"}}, "required": ["path"]}}}],
   "anthropic": {"system": "You can read files.",
                 "tools": [{"name": "read_file", "description": "Read a file",
                            "input_schema": {"type": "object", "properties": {"path": {"type": "string"}, "lines": {"type": "integer"}}, "required": ["path"]}}],
                 "messages": [
                  {"role": "user", "content": "What is in a.txt?"},
                  {"role": "assistant", "content": [{"type": "thinking", "thinking": "Read it.", "signature": "x"},
                                                    {"type": "tool_use", "id": "c1", "name": "read_file", "input": {"path": "a.txt", "lines": 3}}]},
                  {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "c1", "content": "AAA\nBBB"}]},
                  {"role": "assistant", "content": [{"type": "thinking", "thinking": "Got it.", "signature": "x"},
                                                    {"type": "text", "text": "It holds AAA and BBB."}]},
                  {"role": "user", "content": "Thanks. And b.txt?"}]}},

  {"name": "tools, no system message: a new empty system turn carries them",
   "messages": [{"role": "user", "content": "grep for TODO"}],
   "tools": [{"type": "function", "function": {"name": "grep", "description": "Search files",
              "parameters": {"type": "object", "properties": {"pattern": {"type": "string"}, "glob": {"type": "string"}}, "required": ["pattern"]}}},
             {"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "anthropic": {"tools": [{"name": "grep", "description": "Search files",
                            "input_schema": {"type": "object", "properties": {"pattern": {"type": "string"}, "glob": {"type": "string"}}, "required": ["pattern"]}},
                           {"name": "read_file", "description": "Read a file",
                            "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}],
                 "messages": [{"role": "user", "content": "grep for TODO"}]}},

  {"name": "tools, thinking off: the call turn ends the prompt with </think>",
   "messages": [{"role": "user", "content": "Read a.txt"},
                {"role": "assistant", "content": "",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "read_file", "arguments": {"path": "a.txt"}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "AAA"}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "kwargs": {"thinking_mode": "chat"},
   "request": {"reasoning_effort": "none"}},

  {"name": "parallel calls, results in call order; text before the calls",
   "messages": [{"role": "user", "content": "Read a and b"},
                {"role": "assistant", "content": "Reading both.", "reasoning_content": "Two reads.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "read_file", "arguments": {"path": "a"}}},
                                {"id": "c2", "type": "function", "function": {"name": "read_file", "arguments": {"path": "b"}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "AAA"},
                {"role": "tool", "tool_call_id": "c2", "content": "BBB"}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "anthropic": {"tools": [{"name": "read_file", "description": "Read a file",
                            "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}],
                 "messages": [
                  {"role": "user", "content": "Read a and b"},
                  {"role": "assistant", "content": [{"type": "thinking", "thinking": "Two reads.", "signature": "x"},
                                                    {"type": "text", "text": "Reading both."},
                                                    {"type": "tool_use", "id": "c1", "name": "read_file", "input": {"path": "a"}},
                                                    {"type": "tool_use", "id": "c2", "name": "read_file", "input": {"path": "b"}}]},
                  {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "c1", "content": "AAA"},
                                               {"type": "tool_result", "tool_use_id": "c2", "content": "BBB"}]}]}},

  {"name": "parallel calls, results sent out of call order",
   "messages": [{"role": "user", "content": "Read a and b"},
                {"role": "assistant", "content": "", "reasoning_content": "Two reads.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "read_file", "arguments": {"path": "a"}}},
                                {"id": "c2", "type": "function", "function": {"name": "read_file", "arguments": {"path": "b"}}}]},
                {"role": "tool", "tool_call_id": "c2", "content": "BBB"},
                {"role": "tool", "tool_call_id": "c1", "content": "AAA"}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}]},

  {"name": "tool result and user text in one turn",
   "messages": [{"role": "user", "content": "Read a"},
                {"role": "assistant", "content": "", "reasoning_content": "Read.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "read_file", "arguments": {"path": "a"}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "AAA"},
                {"role": "user", "content": "Now summarise it."}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "anthropic": {"tools": [{"name": "read_file", "description": "Read a file",
                            "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}],
                 "messages": [
                  {"role": "user", "content": "Read a"},
                  {"role": "assistant", "content": [{"type": "thinking", "thinking": "Read.", "signature": "x"},
                                                    {"type": "tool_use", "id": "c1", "name": "read_file", "input": {"path": "a"}}]},
                  {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "c1", "content": "AAA"},
                                               {"type": "text", "text": "Now summarise it."}]}]}},

  {"name": "tool result as content blocks; non-string argument values",
   "messages": [{"role": "user", "content": "Run it"},
                {"role": "assistant", "content": "", "reasoning_content": "Run.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "run", "arguments": {"cmd": "ls", "timeout": 30, "env": {"A": "1"}, "args": ["-l", "-a"], "dry": false, "note": null}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": [{"type": "text", "text": "file1"}, {"type": "text", "text": "file2"}]}],
   "tools": [{"type": "function", "function": {"name": "run", "description": "Run a command",
              "parameters": {"type": "object", "properties": {"cmd": {"type": "string"}, "timeout": {"type": "integer"}, "env": {"type": "object"},
                             "args": {"type": "array", "items": {"type": "string"}}, "dry": {"type": "boolean"}, "note": {"type": ["string", "null"]}}}}}]},

  {"name": "consecutive user messages merge into one turn",
   "messages": [{"role": "user", "content": "First part."}, {"role": "user", "content": "Second part."}],
   "anthropic": {"messages": [{"role": "user", "content": "First part."}, {"role": "user", "content": "Second part."}]}},

  {"name": "user content as text parts",
   "messages": [{"role": "user", "content": [{"type": "text", "text": "Part one."}, {"type": "text", "text": "Part two."}]}]},

  {"name": "Claude Code user turn: a reminder text block, then the prompt block",
   "messages": [{"role": "user", "content": [{"type": "text", "text": "<system-reminder>\nToday is Friday.\n</system-reminder>"},
                                             {"type": "text", "text": "Fix the bug in a.py"}]}],
   "serve": false,
   "anthropic": {"messages": [{"role": "user", "content": [{"type": "text", "text": "<system-reminder>\nToday is Friday.\n</system-reminder>"},
                                                           {"type": "text", "text": "Fix the bug in a.py"}]}]}},

  {"name": "images: placeholder per image, between text blocks",
   "messages": [{"role": "user", "content": [{"type": "text", "text": "Compare these:"},
                                             {"type": "image_url", "image_url": {"url": "data:image/png;base64,iVBORw0KGgo="}},
                                             {"type": "image_url", "image_url": {"url": "data:image/png;base64,iVBORw0KGgo="}},
                                             {"type": "text", "text": "Which is brighter?"}]}]},

  {"name": "mid-conversation system message",
   "messages": [{"role": "system", "content": "Be brief."},
                {"role": "user", "content": "Hi"},
                {"role": "assistant", "content": "Hello.", "reasoning_content": "Greet."},
                {"role": "system", "content": "From now on answer in French."},
                {"role": "user", "content": "How are you?"}],
   "known": {"serve": "frontend._late_system_to_user turns a late system message into a user turn (Qwen's template refuses one; kept so the conversation cache and Claude Code hook turns behave as shipped)"}},

  {"name": "mid-conversation system message is the last turn",
   "messages": [{"role": "user", "content": "Hi"},
                {"role": "assistant", "content": "Hello.", "reasoning_content": "Greet."},
                {"role": "system", "content": "Mid-conversation instruction update"}],
   "kwargs": {"thinking_mode": "chat"},
   "request": {"reasoning_effort": "none"},
   "known": {"serve": "frontend._late_system_to_user (as above)"}},

  {"name": "effort 1 (integer)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": 1}, "request": {"reasoning_effort": 1}},
  {"name": "effort 40 (integer)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": 40}, "request": {"reasoning_effort": 40},
   "anthropic": {"messages": [{"role": "user", "content": "Hi"}], "output_config": {"effort": 40}}},
  {"name": "effort 40 as text", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": 40}, "request": {"reasoning_effort": "40"}},
  {"name": "effort 100 (integer)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": 100}, "request": {"reasoning_effort": 100}},
  {"name": "effort low", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "low"}, "request": {"reasoning_effort": "low"},
   "anthropic": {"messages": [{"role": "user", "content": "Hi"}], "output_config": {"effort": "low"}}},
  {"name": "effort high", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "high"}, "request": {"reasoning_effort": "high"},
   "anthropic": {"messages": [{"role": "user", "content": "Hi"}], "output_config": {"effort": "high"}}},
  {"name": "effort max", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "max"}, "request": {"reasoning_effort": "max"},
   "anthropic": {"messages": [{"role": "user", "content": "Hi"}], "output_config": {"effort": "max"}}},
  {"name": "effort xhigh (OpenAI name)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "xhigh"}, "request": {"reasoning_effort": "xhigh"}, "encoder": false},
  {"name": "effort minimal (OpenAI name)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "minimal"}, "request": {"reasoning_effort": "minimal"}, "encoder": false},
  {"name": "effort medium (OpenAI name)", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": "medium"}, "request": {"reasoning_effort": "medium"}, "encoder": false,
   "anthropic": {"messages": [{"role": "user", "content": "Hi"}], "output_config": {"effort": "medium"}},
   "known": {"serve": "serve_ds41.EFFORT maps medium to 62 (between low 50 and high 75, as shipped); DeepSeek's template maps medium to 75",
             "anthropic": "same: medium = 62"}},
  {"name": "effort 62 = what our medium renders", "messages": [{"role": "user", "content": "Hi"}],
   "kwargs": {"reasoning_effort": 62}, "request": {"reasoning_effort": "medium"}},

  {"name": "drop_thinking false keeps every turn's reasoning",
   "messages": [{"role": "user", "content": "Name a prime."},
                {"role": "assistant", "content": "7", "reasoning_content": "Any prime works; 7."},
                {"role": "user", "content": "Another one."}],
   "kwargs": {"drop_thinking": false}, "serve": false},

  {"name": "response_format on the system message",
   "messages": [{"role": "system", "content": "Answer in JSON.",
                 "response_format": {"type": "json_schema", "json_schema": {"name": "a", "schema": {"type": "object", "properties": {"x": {"type": "integer"}}}}}},
                {"role": "user", "content": "Give x."}],
   "serve": false},

  {"name": "tools + response_format together",
   "messages": [{"role": "system", "content": "Use tools, then answer in JSON.",
                 "response_format": {"type": "json_object"}},
                {"role": "user", "content": "Read a and report."}],
   "tools": [{"type": "function", "function": {"name": "read_file", "description": "Read a file",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "serve": false},

  {"name": "namespaced tool (ns::name) and its call",
   "messages": [{"role": "user", "content": "Search"},
                {"role": "assistant", "content": "", "reasoning_content": "Search.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "web::search", "arguments": {"q": "x"}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "R"}],
   "tools": [{"type": "function", "function": {"name": "web::search", "description": "Search the web",
              "parameters": {"type": "object", "properties": {"q": {"type": "string"}}}}}]},

  {"name": "latest_reminder turn", "serve": false,
   "messages": [{"role": "user", "content": "Plan my day."},
                {"role": "latest_reminder", "content": "Today is Friday."}]},

  {"name": "task token (non-action) on the last user turn", "serve": false,
   "messages": [{"role": "user", "content": "Is this a question?", "task": "query"}]},

  {"name": "task token action", "serve": false,
   "messages": [{"role": "user", "content": "Do it.", "task": "action"}]},

  {"name": "DSML-looking text in a user message stays text",
   "messages": [{"role": "user", "content": "What does <｜DSML｜ invoke name=\"x\"> mean?"}]},

  {"name": "unicode and JSON-special characters in a tool's arguments and result",
   "messages": [{"role": "user", "content": "Write it"},
                {"role": "assistant", "content": "", "reasoning_content": "Write.",
                 "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "write", "arguments": {"path": "é/ü.txt", "content": "line \"1\"\n\ttab </｜DSML｜ parameter> 中文"}}}]},
                {"role": "tool", "tool_call_id": "c1", "content": "ok ✓"}],
   "tools": [{"type": "function", "function": {"name": "write", "description": "Write a file — UTF-8",
              "parameters": {"type": "object", "properties": {"path": {"type": "string"}, "content": {"type": "string"}}}}}]}
 ]
}

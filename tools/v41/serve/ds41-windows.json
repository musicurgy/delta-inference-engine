{
  "exe": "${XO_ROOT}/${DS41_BUILD}/ds41_generate.exe",
  "args": [
    "-m",
    "${DS41_MODELS}/ds4-q2-slim.gguf",
    "--backend",
    "cuda",
    "--experts",
    "gpu",
    "--engram",
    "${DS41_MODELS}/engram",
    "--ctx",
    "1048576",
    "--stop",
    "1",
    "--arena-adapt",
    "--kv-fp4",
    "--route-bias",
    "0.28",
    "--route-bias-file",
    "0.3",
    "--arena-gib",
    "auto",
    "--vram-margin",
    "0.6",
    "--prompt-batch",
    "16384",
    "--rank",
    "${XO_ROOT}/data/ds41/rank-1017-share.bin",
    "--pf-b",
    "0.7",
    "--pcie",
    "0.5"
  ],
  "cwd": "${XO_ROOT}",
  "tokenizer": "${DS41_MODELS}/tokenizer",
  "model_name": "deepseek-v4.1-flash-1017-ds4-q2",
  "log": "${XO_ROOT}/logs/strata-ds41.log",
  "port": 8080,
  "gpu": 0,
  "sampling": {
    "temperature": 1,
    "top_p": 0.95
  },
  "api_monitor": true,
  "reasoning_budget_tokens": 32768
}
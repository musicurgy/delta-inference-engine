+
+// around one evaluation (or capture) of a graph's nodes; not with concurrent streams (each stream has its own pool)
+static void ggml_cuda_qfuse_begin(ggml_backend_cuda_context * ctx, const bool concurrent) {
+    if (!ggml_cuda_qfuse_on()) {
+        return;
+    }
+    ggml_cuda_qfuse_state & qs = ggml_cuda_qfuse_state_of(ctx);
+    GGML_ASSERT(qs.images.empty() && qs.held.empty());
+    qs.active = !concurrent;
+}
+
+static void ggml_cuda_qfuse_end(ggml_backend_cuda_context * ctx) {
+    if (!ggml_cuda_qfuse_on()) {
+        return;
+    }
+    ggml_cuda_qfuse_state & qs = ggml_cuda_qfuse_state_of(ctx);
+    qs.images.clear();
+    while (!qs.held.empty()) {
+        qs.held.pop_back();   // reverse allocation order
+    }
+    qs.active = false;

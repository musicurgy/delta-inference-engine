+static __device__ void quantize_f32_nvfp4_ds41_block(const float * __restrict__ x, block_nvfp4 * __restrict__ y) {
+    for (int sb = 0; sb < QK_NVFP4/QK_NVFP4_SUB; ++sb) {
+        const float * xs = x + sb*QK_NVFP4_SUB;
+        float amax = 0.0f;
+        for (int j = 0; j < QK_NVFP4_SUB; ++j) amax = fmaxf(amax, fabsf(xs[j]));
+        float s = 0x1p-9f;
+        bool exact = amax == 0.0f;
+        if (!exact) {
+            const float qm[7] = { 6.0f, 4.0f, 3.0f, 2.0f, 1.5f, 1.0f, 0.5f };
+            for (int k = 0; k < 7 && !exact; ++k) {
+                const float c = ds41_round_e4m3(amax / qm[k]);
+                if (c <= 0.0f) continue;
+                bool ok = true;
+                for (int j = 0; j < QK_NVFP4_SUB && ok; ++j) ok = ds41_e2m1_exact(xs[j], c) >= 0;
+                if (ok) { s = c; exact = true; }
+            }
+            if (!exact) s = fmaxf(ds41_round_e4m3(amax / 6.0f), 0x1p-9f);
+        }
+        y->d[sb] = ds41_e4m3_bits(s);
+        for (int j = 0; j < QK_NVFP4_SUB/2; ++j) {
+            int c0 = ds41_e2m1_exact(xs[j], s), c1 = ds41_e2m1_exact(xs[j + QK_NVFP4_SUB/2], s);
+            if (c0 < 0) c0 = ds41_e2m1_nearest(xs[j] / s) | (xs[j] < 0.0f ? 8 : 0);
+            if (c1 < 0) c1 = ds41_e2m1_nearest(xs[j + QK_NVFP4_SUB/2] / s) | (xs[j + QK_NVFP4_SUB/2] < 0.0f ? 8 : 0);
+            y->qs[sb*(QK_NVFP4_SUB/2) + j] = (uint8_t) (c0 | (c1 << 4));
+        }
+    }

+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, k, n);
+    ggml_set_op_params_i32(result, 0, k);
+    ggml_set_op_params_i32(result, 1, norm ? 1 : 0);
+    ggml_set_op_params_f32(result, 2, scale);
+    result->op     = GGML_OP_DSV4_ROUTE;
+    result->src[0] = logits;
+    result->src[1] = bias;
+    result->src[2] = rbias;
+    result->src[3] = wts;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv4_route_vl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * bias_vl,
+        struct ggml_tensor  * img,
+        struct ggml_tensor  * rbias,
+        struct ggml_tensor  * wts,
+        int                   k,
+        bool                  norm,
+        float                 scale) {
+    struct ggml_tensor * result = ggml_dsv4_route(ctx, logits, bias, rbias, wts, k, norm, scale);
+    GGML_ASSERT(bias_vl->type == GGML_TYPE_F32 && ggml_nelements(bias_vl) == logits->ne[0] && ggml_is_contiguous(bias_vl));
+    GGML_ASSERT(img->type == GGML_TYPE_F32 && ggml_nelements(img) == ggml_nrows(logits) && ggml_is_contiguous(img));
+    result->src[4] = bias_vl;
+    result->src[5] = img;
+    return result;
+}
+
+// op_params[0]: 0 = the keys (ggml_dsv41_kv_gather), 1 = the mask (ggml_dsv41_kv_mask)
+struct ggml_tensor * ggml_dsv41_kv_gather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * ring,
+        struct ggml_tensor  * rows,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        int64_t               m) {
+    GGML_ASSERT(ring->type == GGML_TYPE_F32 || ring->type == GGML_TYPE_F16 || ring->type == GGML_TYPE_BF16);
+    GGML_ASSERT(rows->type == GGML_TYPE_F32 && rows->ne[0] == ring->ne[0]);
+    GGML_ASSERT(ring->nb[0] == ggml_type_size(ring->type) && rows->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_nrows(ring) == ring->ne[1] && ggml_nrows(rows) == rows->ne[1]);
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && widx->nb[0] == sizeof(int32_t) && ggml_nrows(widx) == widx->ne[1]);
+    GGML_ASSERT((comp == NULL) == (sel == NULL));
+    int64_t nk = 0;
+    if (comp) {
+        GGML_ASSERT(comp->type == GGML_TYPE_F32 || comp->type == GGML_TYPE_F16 || comp->type == GGML_TYPE_BF16 ||
+                    (comp->type == GGML_TYPE_NVFP4 && comp->ne[0] % 256 == 0));
+        GGML_ASSERT(comp->ne[0] == ring->ne[0] && ggml_nrows(comp) == comp->ne[1]);
+        GGML_ASSERT(sel->type == GGML_TYPE_I32 && sel->nb[0] == sizeof(int32_t) && sel->ne[1] == widx->ne[1] &&
+                    ggml_nrows(sel) == sel->ne[1]);
+        nk = sel->ne[0];
+    }
+    GGML_ASSERT(m >= widx->ne[0] + nk && m <= INT32_MAX);
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, ring->ne[0], m, widx->ne[1]);
+    ggml_set_op_params_i32(result, 0, 0);
+    result->op     = GGML_OP_DSV41_KV_GATHER;
+    result->src[0] = ring;
+    result->src[1] = rows;
+    result->src[2] = widx;
+    result->src[3] = comp;
+    result->src[4] = sel;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_kv_mask(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * mw,
+        struct ggml_tensor  * mc,
+        int64_t               m) {
+    GGML_ASSERT(mw->type == GGML_TYPE_F32 && mw->nb[0] == sizeof(float) && ggml_nrows(mw) == mw->ne[1]);
+    int64_t nk = 0;
+    if (mc) {
+        GGML_ASSERT(mc->type == GGML_TYPE_F32 && mc->nb[0] == sizeof(float) && mc->ne[1] == mw->ne[1] &&
+                    ggml_nrows(mc) == mc->ne[1]);
+        nk = mc->ne[0];
+    }
+    GGML_ASSERT(m >= mw->ne[0] + nk && m <= INT32_MAX);
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, m, mw->ne[1]);
+    ggml_set_op_params_i32(result, 0, 1);
+    result->op     = GGML_OP_DSV41_KV_GATHER;
+    result->src[0] = mw;
+    result->src[1] = mc;
+    return result;
+}

diff --git a/ggml/src/ggml-cuda/top-k.cu b/ggml/src/ggml-cuda/top-k.cu
index c7a0c8317..d35ab7034 100644
--- a/ggml/src/ggml-cuda/top-k.cu
+++ b/ggml/src/ggml-cuda/top-k.cu
@@ -10,6 +10,201 @@ using namespace cub;
 #    endif  // CCCL_MAJOR_VERSION >= 3 && CCCL_MINOR_VERSION >= 2
 #endif      // GGML_CUDA_USE_CUB
 
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// Xolotl: exact top-k by radix SELECT for a GGML_OP_TOP_K node flagged
+// GGML_TOP_K_XOLOTL_RADIX_ASC (ggml.h) whose rows are wider than 1024 columns.  Without CUB's DeviceTopK (CCCL < 3.2:
+// CUDA 13.0 ships 3.0) the op sorts every whole row (DeviceSegmentedRadixSort under graph capture, DeviceSegmentedSort
+// otherwise) and keeps the first k: DeepSeek-V4.1's indexer sorts 9 rows of up to 64K scores per query per pass for
+// 512 ids (Nsight, 40K: 3.40 ms a pass, 62 us a launch).  This kernel picks the same k with one block per
+// row: three histogram passes over the row (11 + 11 + 10 bits of the order key, each counting only the keys that
+// still match the digits chosen so far) find the k-th largest key T and how many keys equal to T are taken, then one
+// ordered pass writes every column whose key is > T and the first ones (lowest columns) equal to T.
+//
+// That is exactly the first k of a STABLE descending sort, which both CUB sorts are (DeviceSegmentedSort's
+// SortPairsDescending is the same dispatch as its StableSortPairsDescending; radix sorts are stable): equal values go
+// to the lower column.  The order key is CUB's: the float bits mapped to an order-preserving uint, with -0.0 mapped
+// onto +0.0 (cub/block/radix_rank_sort_operations.cuh ProcessFloatMinusZero: CUB ranks the two zeros equal).  NaNs keep
+// their bit order, as in CUB.  The ids come out in ASCENDING column order (the sort gave them by value); callers that
+// set the flag must not depend on the value order.  GGML_CUDA_RADIX_TOPK=0 restores the sort.
+#define TOP_K_RS_THREADS 1024
+#define TOP_K_RS_IPT     8      // columns per thread per chunk of the ordered pass
+
+static __device__ __forceinline__ uint32_t top_k_rs_key(const float v) {
+    const uint32_t u   = __float_as_uint(v);
+    const uint32_t key = (u & 0x80000000u) ? ~u : (u | 0x80000000u);   // unsigned order = float order
+    return key == 0x7FFFFFFFu ? 0x80000000u : key;                      // -0.0 ranks as +0.0 (CUB)
+}
+
+// exclusive prefix sum of v over the block in thread order; total = the block's sum.  Every thread must call it.
+static __device__ __forceinline__ int top_k_rs_scan(const int v, int * s_warp, int & total) {
+    constexpr int NW = TOP_K_RS_THREADS / WARP_SIZE;
+    static_assert(NW <= WARP_SIZE, "one warp scans the warp sums");
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    int inc = v;
+#pragma unroll
+    for (int o = 1; o < WARP_SIZE; o <<= 1) {
+        const int t = __shfl_up_sync(0xFFFFFFFFu, inc, o, WARP_SIZE);
+        if (lane >= o) {
+            inc += t;
+        }
+    }
+    if (lane == WARP_SIZE - 1) {
+        s_warp[warp] = inc;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        const int wv = lane < NW ? s_warp[lane] : 0;
+        int winc = wv;
+#pragma unroll
+        for (int o = 1; o < WARP_SIZE; o <<= 1) {
+            const int t = __shfl_up_sync(0xFFFFFFFFu, winc, o, WARP_SIZE);
+            if (lane >= o) {
+                winc += t;
+            }
+        }
+        if (lane < NW) {
+            s_warp[lane] = winc - wv;
+        }
+        if (lane == WARP_SIZE - 1) {
+            s_warp[NW] = winc;
+        }
+    }
+    __syncthreads();
+    const int excl = s_warp[warp] + inc - v;
+    total = s_warp[NW];
+    __syncthreads();   // s_warp is free again when this returns
+    return excl;
+}
+
+static __global__ void __launch_bounds__(TOP_K_RS_THREADS) k_top_k_rsel_asc(
+        const float * __restrict__ x, int * __restrict__ dst, const int ncols, const int k) {
+    __shared__ int      s_hist[2048];
+    __shared__ int      s_warp[TOP_K_RS_THREADS / WARP_SIZE + 1];
+    __shared__ uint32_t s_digit;
+    __shared__ int      s_rank;
+
+    const float * xr  = x   + (int64_t) blockIdx.x * ncols;
+    int *         dr  = dst + (int64_t) blockIdx.x * k;
+    const int     tid = threadIdx.x;
+
+    // ---- select: T = the k-th largest key; rank = how many keys equal to T are taken
+    uint32_t prefix = 0;   // the digits chosen so far
+    uint32_t pmask  = 0;   // their bits
+    int      rank   = k;   // keys still to take among those matching prefix under pmask (>= 1, <= their count)
+    for (int pass = 0; pass < 3; ++pass) {
+        const int      shift = pass == 0 ? 21 : (pass == 1 ? 10 : 0);
+        const int      nbins = pass == 2 ? 1024 : 2048;
+        const uint32_t dmask = (uint32_t) nbins - 1;
+        for (int i = tid; i < nbins; i += TOP_K_RS_THREADS) {
+            s_hist[i] = 0;
+        }
+        __syncthreads();
+        for (int c0 = 0; c0 < ncols; c0 += TOP_K_RS_THREADS) {   // every warp runs every iteration (convergent)
+            const int c = c0 + tid;
+            uint32_t  d = 0xFFFFFFFFu;                           // not counted
+            if (c < ncols) {
+                const uint32_t key = top_k_rs_key(xr[c]);
+                if ((key & pmask) == prefix) {
+                    d = (key >> shift) & dmask;
+                }
+            }
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+            // one shared atomic per distinct digit of the warp: the first pass sees long runs of one digit (the -inf
+            // of every masked row, scores of one exponent)
+            if (__any_sync(0xFFFFFFFFu, d != 0xFFFFFFFFu)) {
+                const unsigned peers = __match_any_sync(0xFFFFFFFFu, d);
+                if (d != 0xFFFFFFFFu && (tid % WARP_SIZE) == __ffs(peers) - 1) {
+                    atomicAdd(&s_hist[d], __popc(peers));
+                }
+            }
+#else
+            if (d != 0xFFFFFFFFu) {
+                atomicAdd(&s_hist[d], 1);
+            }
+#endif
+        }
+        __syncthreads();
+        // thread t owns the bins (nbins - 1 - t*per) downwards; the bin where the running count from the top first
+        // reaches rank holds the rank-th largest matching key
+        const int per = nbins / TOP_K_RS_THREADS;
+        int sum = 0;
+        for (int j = 0; j < per; ++j) {
+            sum += s_hist[nbins - 1 - (tid * per + j)];
+        }
+        int total;
+        int before = top_k_rs_scan(sum, s_warp, total);
+        for (int j = 0; j < per; ++j) {
+            const int b = nbins - 1 - (tid * per + j);
+            const int h = s_hist[b];
+            if (before < rank && before + h >= rank) {   // exactly one bin of the block
+                s_digit = (uint32_t) b;
+                s_rank  = rank - before;
+            }
+            before += h;
+        }
+        __syncthreads();
+        prefix |= s_digit << shift;
+        pmask  |= dmask << shift;
+        rank    = s_rank;
+        __syncthreads();   // s_hist, s_digit and s_rank are reused by the next pass
+    }
+
+    // ---- gather in ascending column order: column c goes to (keys > T before it) + min(keys == T before it, rank)
+    const uint32_t T = prefix;
+    int run_gt = 0;   // keys > T in the chunks done
+    int run_eq = 0;   // keys == T in the chunks done
+    for (int c0 = 0; c0 < ncols; c0 += TOP_K_RS_THREADS * TOP_K_RS_IPT) {
+        const int cb = c0 + tid * TOP_K_RS_IPT;
+        uint32_t keys[TOP_K_RS_IPT];
+        int ngt = 0;
+        int neq = 0;
+#pragma unroll
+        for (int i = 0; i < TOP_K_RS_IPT; ++i) {
+            const int c = cb + i;
+            keys[i] = c < ncols ? top_k_rs_key(xr[c]) : 0u;
+            if (c < ncols) {
+                ngt += keys[i] >  T;
+                neq += keys[i] == T;
+            }
+        }
+        // both counts in one scan: a chunk holds 8192 columns < 2^16, so the low half never carries
+        int total;
+        const int before = top_k_rs_scan(ngt | (neq << 16), s_warp, total);
+        int g = run_gt + (before & 0xFFFF);
+        int e = run_eq + (before >> 16);
+#pragma unroll
+        for (int i = 0; i < TOP_K_RS_IPT; ++i) {
+            const int c = cb + i;
+            if (c < ncols) {
+                if (keys[i] > T) {
+                    dr[g + min(e, rank)] = c;
+                    ++g;
+                } else if (keys[i] == T) {
+                    if (e < rank) {
+                        dr[g + e] = c;
+                    }
+                    ++e;
+                }
+            }
+        }
+        run_gt += total & 0xFFFF;
+        run_eq += total >> 16;
+        if (run_gt + min(run_eq, rank) >= k) {   // block-uniform: all k written
+            break;
+        }
+    }
+}
+
+static bool top_k_radix_select_on() {
+    static const bool on = [] {
+        const char * v = getenv("GGML_CUDA_RADIX_TOPK");
+        return !(v && v[0] == '0');
+    }();
+    return on;
+}
+#endif // !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)

+// with an F16 destination rounds (ggml_cuda_cast<half>(float)); a new row (F32) and an F32 / BF16 compressed row round
+// the same way; an F16 compressed row is copied (get_rows F16 -> F16); an NVFP4 row goes through dequantize_nvfp4 with
+// the same 32-lane split get_rows_cuda_kq<32> uses; padding rows are +0 and padded mask entries -inf (ggml_fill + cast).
+// One warp per destination key row; the warp's lanes stride the row.
+template<typename ring_t, ggml_type comp_type>
+static __global__ void k_dsv41_kv_gather(
+        const char * __restrict__ ring, const size_t nb_ring, const int nring,
+        const char * __restrict__ rows, const size_t nb_rows,
+        const int32_t * __restrict__ widx, const int64_t s_widx, const int nw,
+        const char * __restrict__ comp, const size_t nb_comp,
+        const int32_t * __restrict__ sel, const int64_t s_sel, const int nk,
+        half * __restrict__ dst, const int d, const int m, const int64_t n) {
+    const int lane = threadIdx.x;
+    const int j    = blockIdx.x*blockDim.y + threadIdx.y;
+    if (j >= m) {
+        return;
+    }
+    for (int64_t q = blockIdx.y; q < n; q += gridDim.y) {
+        half * y = dst + ((size_t) q*m + j)*d;
+        if (j < nw) {
+            const int r = widx[q*s_widx + j];
+            if (r < nring) {
+                const ring_t * x = (const ring_t *) (ring + (size_t) r*nb_ring);
+                for (int i = lane; i < d; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(x[i]));
+                }
+            } else {
+                const float * x = (const float *) (rows + (size_t) (r - nring)*nb_rows);
+                for (int i = lane; i < d; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(x[i]);
+                }
+            }
+        } else if (j < nw + nk) {
+            const char * x = comp + (size_t) sel[q*s_sel + (j - nw)]*nb_comp;
+            if constexpr (comp_type == GGML_TYPE_NVFP4) {
+                for (int sb = 0; sb < d/QK_K; ++sb) {
+                    dequantize_nvfp4<half>(x, sb, y + sb*QK_K, lane);
+                }
+            } else if constexpr (comp_type == GGML_TYPE_F16) {
+                for (int i = lane; i < d; i += WARP_SIZE) {
+                    y[i] = ((const half *) x)[i];
+                }
+            } else if constexpr (comp_type == GGML_TYPE_BF16) {
+                for (int i = lane; i < d; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(ggml_cuda_cast<float>(((const nv_bfloat16 *) x)[i]));
+                }
+            } else {
+                for (int i = lane; i < d; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(((const float *) x)[i]);
+                }
+            }
+        } else {
+            for (int i = lane; i < d; i += WARP_SIZE) {
+                y[i] = __float2half(0.0f);
+            }
+        }
+    }
+}
+
+static __global__ void k_dsv41_kv_mask(
+        const char * __restrict__ mw, const size_t nb_mw, const int nw,
+        const char * __restrict__ mc, const size_t nb_mc, const int nk,
+        half * __restrict__ dst, const int m, const int64_t n) {
+    const int j = blockIdx.x*blockDim.x + threadIdx.x;
+    if (j >= m) {
+        return;
+    }
+    for (int64_t q = blockIdx.y; q < n; q += gridDim.y) {
+        float v = -INFINITY;
+        if (j < nw) {
+            v = ((const float *) (mw + (size_t) q*nb_mw))[j];
+        } else if (j < nw + nk) {
+            v = ((const float *) (mc + (size_t) q*nb_mc))[j - nw];
+        }
+        dst[(size_t) q*m + j] = ggml_cuda_cast<half>(v);
+    }
+}
+
+template<typename ring_t, ggml_type comp_type>
+static void dsv41_kv_gather_launch(const ggml_tensor * dst, cudaStream_t stream) {
+    const ggml_tensor * ring = dst->src[0];
+    const ggml_tensor * rows = dst->src[1];
+    const ggml_tensor * widx = dst->src[2];
+    const ggml_tensor * comp = dst->src[3];
+    const ggml_tensor * sel  = dst->src[4];
+    const int d = (int) dst->ne[0];
+    const int m = (int) dst->ne[1];
+    const int64_t n = dst->ne[2];
+    const dim3 block_dims(WARP_SIZE, 4, 1);
+    const dim3 block_nums((m + 3)/4, (unsigned) MIN(n, (int64_t) UINT16_MAX), 1);
+    k_dsv41_kv_gather<ring_t, comp_type><<<block_nums, block_dims, 0, stream>>>(
+        (const char *) ring->data, ring->nb[1], (int) ring->ne[1],
+        (const char *) rows->data, rows->nb[1],
+        (const int32_t *) widx->data, (int64_t) (widx->nb[1]/sizeof(int32_t)), (int) widx->ne[0],
+        comp ? (const char *) comp->data : nullptr, comp ? comp->nb[1] : 0,
+        sel ? (const int32_t *) sel->data : nullptr, sel ? (int64_t) (sel->nb[1]/sizeof(int32_t)) : 0, sel ? (int) sel->ne[0] : 0,
+        (half *) dst->data, d, m, n);
+}
+
+template<typename ring_t>
+static void dsv41_kv_gather_switch_comp(const ggml_tensor * dst, cudaStream_t stream) {
+    const ggml_tensor * comp = dst->src[3];
+    switch (comp ? comp->type : GGML_TYPE_F32) {
+        case GGML_TYPE_NVFP4:
+            dsv41_kv_gather_launch<ring_t, GGML_TYPE_NVFP4>(dst, stream);
+            break;
+        case GGML_TYPE_F16:
+            dsv41_kv_gather_launch<ring_t, GGML_TYPE_F16>(dst, stream);
+            break;
+        case GGML_TYPE_BF16:
+            dsv41_kv_gather_launch<ring_t, GGML_TYPE_BF16>(dst, stream);
+            break;
+        case GGML_TYPE_F32:
+            dsv41_kv_gather_launch<ring_t, GGML_TYPE_F32>(dst, stream);
+            break;
+        default:
+            GGML_ABORT("%s: unsupported comp type: %s\n", __func__, ggml_type_name(comp->type));
+    }
+}
+
+bool ggml_cuda_dsv41_kv_gather_supported(const ggml_tensor * op) {
+    if (op->type != GGML_TYPE_F16 || !ggml_is_contiguous(op)) {
+        return false;
+    }
+    if (op->op_params[0] == 1) {
+        return op->src[0]->type == GGML_TYPE_F32 && (op->src[1] == nullptr || op->src[1]->type == GGML_TYPE_F32);
+    }
+    const ggml_tensor * ring = op->src[0];
+    const ggml_tensor * comp = op->src[3];
+    const bool ring_ok = ring->type == GGML_TYPE_F32 || ring->type == GGML_TYPE_F16 || ring->type == GGML_TYPE_BF16;
+    const bool comp_ok = comp == nullptr || comp->type == GGML_TYPE_F32 || comp->type == GGML_TYPE_F16 ||
+        comp->type == GGML_TYPE_BF16 || (comp->type == GGML_TYPE_NVFP4 && comp->ne[0] % QK_K == 0);
+    return ring_ok && comp_ok && op->src[1]->type == GGML_TYPE_F32;
+}
+
+void ggml_cuda_op_dsv41_kv_gather(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    cudaStream_t stream = ctx.stream();
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && ggml_is_contiguous(dst));
+    if (dst->op_params[0] == 1) {
+        const ggml_tensor * mw = dst->src[0];
+        const ggml_tensor * mc = dst->src[1];
+        const int m = (int) dst->ne[0];
+        const int64_t n = dst->ne[1];
+        const dim3 block_dims(256, 1, 1);
+        const dim3 block_nums((m + 255)/256, (unsigned) MIN(n, (int64_t) UINT16_MAX), 1);
+        k_dsv41_kv_mask<<<block_nums, block_dims, 0, stream>>>(
+            (const char *) mw->data, mw->nb[1], (int) mw->ne[0],
+            mc ? (const char *) mc->data : nullptr, mc ? mc->nb[1] : 0, mc ? (int) mc->ne[0] : 0,
+            (half *) dst->data, m, n);
+        return;
+    }
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            dsv41_kv_gather_switch_comp<float>(dst, stream);
+            break;
+        case GGML_TYPE_F16:
+            dsv41_kv_gather_switch_comp<half>(dst, stream);
+            break;
+        case GGML_TYPE_BF16:
+            dsv41_kv_gather_switch_comp<nv_bfloat16>(dst, stream);
+            break;
+        default:
+            GGML_ABORT("%s: unsupported ring type: %s\n", __func__, ggml_type_name(dst->src[0]->type));
+    }
+}

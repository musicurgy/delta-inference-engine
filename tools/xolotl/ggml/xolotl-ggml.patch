+// Strata DS4.1 --kv-fp4, STRATA_INDEXER_V2=1: the vec kernel's scores, bit for bit, without its warp shuffles.
+//
+// The vec kernel gives a key to a warp: lane l holds K[4l..4l+3] and Q[h][4l..4l+3], forms the partial
+//   p_l = fma(q.w, k.w, fma(q.z, k.z, fma(q.y, k.y, fma(q.x, k.x, 0))))
+// and warp_reduce_sum adds the 32 partials in xor-butterfly order (offsets 16, 8, 4, 2, 1): lane 0 ends with
+//   s16[j] = p[j] + p[j+16], s8[j] = s16[j] + s16[j+8], s4[j] = s8[j] + s8[j+4], s2[j] = s4[j] + s4[j+2], s2[0] + s2[1]
+// (all lanes hold the same value: an IEEE add is commutative).  Then relu, and score = fma(relu, w[h], score) head by
+// head (nvcc contracts "score += sum*w" and "acc += v*u" under -use_fast_math - fma.rn.ftz.f32 in the PTX).
+//
+// Here one THREAD owns a key: its 128 K values are dequantized once into registers (the same dequantize_V call the
+// vec kernel makes per lane, so the same floats), Q comes from shared memory as a warp-wide broadcast, and the 32
+// partials are made in bit-reversed lane order (0, 16, 8, 24, 4, ...) so the butterfly tree above folds incrementally
+// with at most 5 partials in flight - the same adds of the same operands, in the same tree.  The fma / add / relu
+// are written as explicit __fmaf_rn / __fadd_rn so nothing depends on contraction (both compile to fma.rn.ftz.f32 /
+// add.rn.ftz.f32 under -use_fast_math, as the vec kernel's do).
+//
+// Masked-block skip: the vec kernel decides per 64-key block (K_VECS_PER_BLOCK); a skipped block writes the mask
+// value (-inf) where the full path would write score + -inf (also -inf unless the score is +inf / NaN).  To keep even
+// that case identical this kernel makes the same decision on the same 64-key groups (a block holds
+// KEYS_PER_BLOCK / 64 of them; a dead group's two warps skip the math but still meet the barriers).
+template <int KEYS_PER_BLOCK, int64_t N_EMBD, int64_t N_HEAD, ggml_type TYPE_K>
+static __global__ void __launch_bounds__(KEYS_PER_BLOCK) lightning_indexer_kernel_v2(
+        const float * Q, const char * K, const float * W, const half * M, float * dst,
+        int64_t n_stream, int64_t n_batch, int64_t n_kv,
+        size_t nb1, size_t nb2, size_t nb3,
+        size_t nbq1, size_t nbq2, size_t nbq3,
+        size_t nbk1, size_t nbk2, size_t nbk3,
+        size_t nbw1, size_t nbw2, size_t nbw3,
+        size_t nbm1, size_t nbm2, size_t nbm3,
+        int64_t nem3, int skip_masked
+    ) {
+    static_assert(N_EMBD == 128 && WARP_SIZE == 32, "the lane split mirrors the vec kernel: 32 lanes x float4 = 128");
+    constexpr int SKIP_GROUP = 64;                    // the vec kernel's K_VECS_PER_BLOCK (8 warps x 8 keys)
+    static_assert(KEYS_PER_BLOCK % SKIP_GROUP == 0, "whole skip groups per block");
+    constexpr int N_GROUPS     = KEYS_PER_BLOCK / SKIP_GROUP;
+    constexpr int N_LANES      = N_EMBD / 4;          // 32: the vec kernel's lanes
+    constexpr int N_HEAD_INNER = N_HEAD / 4;          // Q / w staged in shared memory N_HEAD/4 heads at a time
+
+    const int i_batch  = blockIdx.y;
+    const int i_stream = blockIdx.z;
+    const int tid      = threadIdx.x;
+
+    const int64_t start_kv_block = (int64_t) blockIdx.x * KEYS_PER_BLOCK;
+    const int64_t i_kv           = start_kv_block + tid;
+
+    const half * m_base   = (const half *) ((const char *) M + i_batch*nbm1 + (i_stream%nem3)*nbm3);
+    float      * dst_base = (float *) ((char *) dst + i_batch*nb1 + i_stream*nb3);
+
+    bool active = true;   // warp-uniform: a skip group is two whole warps
+    if (skip_masked) {
+        __shared__ int group_live[N_GROUPS];
+        if (tid < N_GROUPS) {
+            group_live[tid] = 0;
+        }
+        __syncthreads();
+        if (i_kv < n_kv && __half2float(m_base[i_kv]) != -INFINITY) {
+            group_live[tid / SKIP_GROUP] = 1;
+        }
+        __syncthreads();
+        active = group_live[tid / SKIP_GROUP] != 0;
+        bool any = false;
+#pragma unroll
+        for (int g = 0; g < N_GROUPS; ++g) {
+            any = any || group_live[g] != 0;
+        }
+        if (!active && i_kv < n_kv) {
+            dst_base[i_kv] = __half2float(m_base[i_kv]);   // -inf, as the vec kernel's skipped block writes
+        }
+        if (!any) {
+            return;   // block-uniform
+        }
+    }
+
+    const char  * q_base = (const char  *)                 Q + i_batch*nbq2 + i_stream*nbq3;
+    const float * w_base = (const float *) ((const char *) W + i_batch*nbw1 + i_stream*nbw3);
+
+    // this thread's key, dequantized exactly as the vec kernel's lane l dequantizes K[4l..4l+3]
+    float4 k_reg[N_LANES];
+    if (active && i_kv < n_kv) {
+        if constexpr (TYPE_K == GGML_TYPE_F32) {
+            const float4 * k_base = (const float4 *) ((const char *) K + i_kv*nbk2 + i_stream*nbk3);
+#pragma unroll
+            for (int l = 0; l < N_LANES; ++l) {
+                k_reg[l] = k_base[l];
+            }
+        } else {
+            constexpr dequantize_V_t dequantize_k = get_dequantize_V<TYPE_K, float, 4>();
+            const void * k_base = (const void *) ((const char *) K + i_kv*nbk2 + i_stream*nbk3);
+#pragma unroll
+            for (int l = 0; l < N_LANES; ++l) {
+                dequantize_k(k_base, &k_reg[l], l * 4);
+            }
+        }
+    } else {
+#pragma unroll
+        for (int l = 0; l < N_LANES; ++l) {
+            k_reg[l] = make_float4(0, 0, 0, 0);
+        }
+    }
+
+    float score = 0.0f;
+
+    __shared__ float  w_shared[N_HEAD_INNER];
+    __shared__ float4 q_shared_f[N_HEAD_INNER][N_LANES];
+
+    for (int i_head_0 = 0; i_head_0 < N_HEAD; i_head_0 += N_HEAD_INNER) {
+        if (tid < N_HEAD_INNER) {
+            w_shared[tid] = w_base[i_head_0 + tid];
+        }
+        constexpr int n_q = N_HEAD_INNER * N_LANES;
+#pragma unroll
+        for (int i_q = tid; i_q < n_q; i_q += KEYS_PER_BLOCK) {
+            const int i_head_inner = i_q / N_LANES;
+            const int i_head = i_head_0 + i_head_inner;
+            const int i_embd = i_q % N_LANES;
+            q_shared_f[i_head_inner][i_embd] = *(const float4 *) (q_base + i_head*nbq1 + i_embd*sizeof(float4));
+        }
+
+        __syncthreads();
+
+        if (active) {
+            for (int i_head_inner = 0; i_head_inner < N_HEAD_INNER; ++i_head_inner) {
+                // butterfly tree, folded in bit-reversed lane order: a_n holds the pending left operand of level n
+                float a0 = 0.0f, a1 = 0.0f, a2 = 0.0f, a3 = 0.0f, a4 = 0.0f;
+                float sum = 0.0f;
+#pragma unroll
+                for (int t = 0; t < N_LANES; ++t) {
+                    const int l = ((t & 1) << 4) | ((t & 2) << 2) | (t & 4) | ((t & 8) >> 2) | ((t & 16) >> 4);
+                    const float4 q = q_shared_f[i_head_inner][l];
+                    float p = 0.0f;
+                    p = __fmaf_rn(q.x, k_reg[l].x, p);
+                    p = __fmaf_rn(q.y, k_reg[l].y, p);
+                    p = __fmaf_rn(q.z, k_reg[l].z, p);
+                    p = __fmaf_rn(q.w, k_reg[l].w, p);
+                    if (t & 1) {
+                        p = __fadd_rn(a0, p);                       // s16
+                        if (t & 2) {
+                            p = __fadd_rn(a1, p);                   // s8
+                            if (t & 4) {
+                                p = __fadd_rn(a2, p);               // s4
+                                if (t & 8) {
+                                    p = __fadd_rn(a3, p);           // s2
+                                    if (t & 16) {
+                                        sum = __fadd_rn(a4, p);     // s1 (t == 31)
+                                    } else {
+                                        a4 = p;
+                                    }
+                                } else {
+                                    a3 = p;
+                                }
+                            } else {
+                                a2 = p;
+                            }
+                        } else {
+                            a1 = p;
+                        }
+                    } else {
+                        a0 = p;
+                    }
+                }
+
+                // ReLU, weight - as the vec kernel's lane 0
+                sum = (sum > 0.0f) ? sum : 0.0f;
+                score = __fmaf_rn(sum, w_shared[i_head_inner], score);
+            }
+        }
+
+        __syncthreads();
+    }
+
+    if (active && i_kv < n_kv) {
+        dst_base[i_kv] = __fadd_rn(score, __half2float(m_base[i_kv]));
+    }

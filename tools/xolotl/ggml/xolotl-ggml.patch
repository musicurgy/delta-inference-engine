+            nba0 / sizeof(float), nba1 / sizeof(float),
             nbr0 / sizeof(float), nbr1 / sizeof(float), nbr2 / sizeof(float),
             nbp0 / sizeof(float), nbp1 / sizeof(float),
             nbc0 / sizeof(float), nbc1 / sizeof(float), nbc2 / sizeof(float),
             nbd0 / sizeof(float), nbd1 / sizeof(float), nbd2 / sizeof(float));
 }
+
+
+// ---- Strata-DS4: GGML_OP_DSV41_FAKE_QUANT - DeepSeek-V4.1's activation quantize-dequantize in one kernel.
+// tools/v41/engine/ds41_ops.hpp builds it from ~45 stock ops per call (abs, pool max, clamp, div, scale, step, ...);
+// this repeats that composite step for step under the same -use_fast_math flags, so the values are bit-identical:
+// a stock binary op is one plain op (__fadd_rn / __fsub_rn / __fmul_rn: .rn.ftz, never contracted, = binbcast's
+// a op b), division is '/' (div.approx.ftz, = binbcast's op_div), ggml_scale is scale_f32's `scale * x + bias` = one
+// FMA (__fmaf_rn), abs = fabsf, step = x > 0, clamp = fminf(fmaxf), the pool's max = fmaxf over the block.
+
+static __device__ __forceinline__ float dsv41_fq_scale(float x, float s, float b) { return __fmaf_rn(s, x, b); }
+static __device__ __forceinline__ float dsv41_fq_step(float x) { return x > 0.0f ? 1.0f : 0.0f; }
+static __device__ __forceinline__ float dsv41_fq_clamp(float x, float lo, float hi) { return fminf(fmaxf(x, lo), hi); }
+
+static __device__ __forceinline__ float dsv41_fq_pow2_ceil(float a) {
+    const float g  = dsv41_fq_scale(a, 8388609.0f, 0.0f);                 // a * (2^23 + 1)
+    const float hi = __fadd_rn(g, __fsub_rn(a, g));                        // a rounded to 1 significant bit
+    return __fmul_rn(hi, dsv41_fq_scale(dsv41_fq_step(__fsub_rn(a, hi)), 1.0f, 1.0f));
+}
+
+static __device__ __forceinline__ float dsv41_fq_pow2_floor(float a) {
+    const float f = dsv41_fq_pow2_ceil(a);
+    return __fmul_rn(f, dsv41_fq_scale(dsv41_fq_step(__fsub_rn(f, a)), -0.5f, 1.0f));
+}
+
+static __device__ __forceinline__ float dsv41_fq_round_fmt(float v, int mbits, float min_normal) {
+    const float p = dsv41_fq_clamp(dsv41_fq_pow2_floor(fabsf(v)), min_normal, INFINITY);
+    const float k = (float) (1 << mbits);
+    const float C = 12582912.0f;                                           // 1.5 * 2^23: round half to even
+    const float y = dsv41_fq_scale(v / p, k, 0.0f);
+    const float r = dsv41_fq_scale(dsv41_fq_scale(y, 1.0f, C), 1.0f, -C);
+    return __fmul_rn(dsv41_fq_scale(r, 1.0f / k, 0.0f), p);
+}
+
+// one thread per element; a block of BS elements = BS consecutive lanes (n % BS == 0, so a lane group is wholly in or
+// wholly out of range and every lane takes part in the shuffles)
+template <int BS>
+static __global__ void dsv41_fake_quant_f32(const float * __restrict__ x, float * __restrict__ y, const int64_t n,
+                                            const int mode, const float maxv, const float floor_) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const float xi = i < n ? x[i] : 0.0f;
+    float a = i < n ? fabsf(xi) : -FLT_MAX;
+#pragma unroll
+    for (int o = BS / 2; o > 0; o >>= 1) {
+        a = fmaxf(a, __shfl_xor_sync(0xffffffff, a, o, BS));
+    }
+    if (i >= n) {
+        return;
+    }
+    const float t = dsv41_fq_clamp(a, floor_, INFINITY) / maxv;
+    const float s = mode == 1 ? dsv41_fq_round_fmt(t, 3, 0x1p-6f) : dsv41_fq_pow2_ceil(t);
+    const float v = dsv41_fq_clamp(xi / s, -maxv, maxv);
+    const float q = mode == 0 ? dsv41_fq_round_fmt(v, 3, 0x1p-6f) : dsv41_fq_round_fmt(v, 1, 1.0f);
+    y[i] = __fmul_rn(q, s);
+}
+
+void ggml_cuda_op_dsv41_fake_quant(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && ggml_is_contiguous(src0));
+    const int mode = ggml_get_op_params_i32(dst, 0);
+    const int64_t n = ggml_nelements(src0);
+    const float maxv = mode == 0 ? 448.0f : 6.0f;
+    const float floor_ = mode == 0 ? 1e-4f : mode == 1 ? 6.0f / 512.0f : 6.0f * 0x1p-126f;
+    const int64_t blocks = (n + 255) / 256;
+    cudaStream_t stream = ctx.stream();
+    if (mode == 1) {
+        GGML_ASSERT(n % 16 == 0);
+        dsv41_fake_quant_f32<16><<<blocks, 256, 0, stream>>>((const float *) src0->data, (float *) dst->data, n, mode, maxv, floor_);
+    } else {
+        GGML_ASSERT(n % 32 == 0);
+        dsv41_fake_quant_f32<32><<<blocks, 256, 0, stream>>>((const float *) src0->data, (float *) dst->data, n, mode, maxv, floor_);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// ---- Strata-DS4: GGML_OP_DSV41_HC_MIXES - the two HC mixes of one model.py Block.hc_mixes in one kernel.
+// tools/v41/engine/ds41_dense.cpp hc_mixes builds them from mul + add + sigmoid + ggml_scale(_bias); this repeats that
+// composite step for step under the same -use_fast_math flags, so the values are bit-identical:
+// a stock binary op is one plain op (__fmul_rn / __fadd_rn: .rn.ftz, never contracted, = binbcast's a op b), ggml_scale
+// is scale_f32's `scale * x + bias` = one FMA (__fmaf_rn), sigmoid is unary_op_kernel's op_sigmoid.
+static __device__ __forceinline__ float dsv41_hc_mix_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+// one thread per output element: dst [hc, 2*nt] = [ pre | post ]
+static __global__ void dsv41_hc_mixes_f32(
+        const float * __restrict__ mixes,
+        const int64_t nrow,                                // mixes->ne[0] = 2*hc (+ hc*hc comb rows the op does not read)
+        const float * __restrict__ scale,
+        const float * __restrict__ base,
+        float * __restrict__ dst,
+        const int64_t hc,
+        const int64_t nt,
+        const float eps) {
+    const int64_t n = 2*hc*nt;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t h    = i % hc;
+    const int64_t col  = i / hc;                       // 0..nt-1 = the pre mix, nt..2*nt-1 = the post mix
+    const int64_t post = col >= nt;
+    const int64_t t    = post ? col - nt : col;
+    const int64_t r    = post ? hc + h : h;
+    const float   v    = __fadd_rn(__fmul_rn(mixes[r + nrow*t], scale[post]), base[r]);
+    const float   s    = dsv41_hc_mix_sigmoid(v);
+    dst[i] = post ? __fmaf_rn(2.0f, s, 0.0f) : __fmaf_rn(1.0f, s, eps);
+}
+
+void ggml_cuda_op_dsv41_hc_mixes(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes));
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_nelements(scale) == 2);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->ne[1] % 2 == 0 && mixes->ne[0] >= dst->ne[0] * 2);
+    const int64_t hc = base->ne[0] / 2;
+    const int64_t nt = dst->ne[1] / 2;
+    const float   eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t n = 2*hc*nt;
+    const int64_t blocks = (n + 255) / 256;
+    cudaStream_t stream = ctx.stream();
+    dsv41_hc_mixes_f32<<<blocks, 256, 0, stream>>>((const float *) mixes->data, mixes->ne[0], (const float *) scale->data,
+                                                   (const float *) base->data, (float *) dst->data, hc, nt, eps);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// ---- Strata-DS4: GGML_OP_DSV4_ROUTE - DeepSeek-V4's router tail (model.py Gate) in one kernel, one warp per token.
+// tools/v41/engine/ds41_dense.cpp builds it from softplus + sqrt (unary_op_kernel), two adds (binbcast), argsort_top_k
+// (k_argsort_topk_warp_f32_i32), get_rows, sum_rows (reduce_rows_f32), scale_bias, div and scale; this repeats each
+// step under the same -use_fast_math flags, so ids and weights are bit-identical:
+//   softplus / sqrt     unary.cu's op_softplus / op_sqrt, verbatim
+//   the bias adds       one plain add each (__fadd_rn), in the composite's order: (s + bias) + rbias
+//   top-k               the same 64-bit keys (order-mapped float << 32 | column) and the same min-reduction: descending,
+//                       ties to the lower expert
+//   sum_rows            for k <= 32 reduce_rows_f32 is warp_reduce_sum over lanes 0..k-1 (the block's other partial
+//                       sums are +0.0f): the same call here on the same lanes
+//   scale_bias / scale  scale_f32's `scale * x + bias` = one FMA (__fmaf_rn); div = op_div's a / b
+//   vision bias         (ggml_dsv4_route_vl, STRATA_FUSE) the chain's sub / repeat / mul / add (binbcast.cu's op_sub,
+//                       op_repeat, op_mul, op_add: one kernel and one F32 rounding each) as __fsub_rn / __fmul_rn /
+//                       __fadd_rn in the same order, bsel = ((bias_vl - bias) * img[row]) + bias; the _rn intrinsics are
+//                       never contracted into an FMA, so each step rounds exactly as its own kernel did
+static __device__ __forceinline__ float dsv4_route_softplus(float x) {
+    return (x > 20.0f) ? x : logf(1.0f + expf(x));
+}
+
+template <int NPL>
+static __global__ void dsv4_route_f32(
+        const float * __restrict__ logits, const int64_t s_row,   // [ne, nrows], row stride in floats
+        const float * __restrict__ bias,
+        const float * __restrict__ rbias,
+        const float * __restrict__ bias_vl,                       // [ne] or null (no vision bias)
+        const float * __restrict__ img,                           // [nrows] image-position mask, used with bias_vl
+        int * __restrict__ ids,                                   // [k, nrows] contiguous
+        float * __restrict__ wts, const int64_t w_row,           // [k, nrows] rows w_row floats apart; null = ids only
+        const int ne, const int k, const int nrows, const int norm, const float scale) {
+    const int row = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32;
+    if (row >= nrows) {
+        return;
+    }
+    const int lane = threadIdx.x & 31;
+    const float * x = logits + (int64_t) row * s_row;
+    const float im = bias_vl ? img[row] : 0.0f;
+    float sc[NPL];
+    unsigned long long key[NPL];
+#pragma unroll
+    for (int i = 0; i < NPL; ++i) {
+        const int c = lane + 32 * i;
+        unsigned long long kk = ~0ull;   // padding: after every real column
+        sc[i] = 0.0f;
+        if (c < ne) {
+            sc[i] = sqrtf(dsv4_route_softplus(x[c]));
+            const float bsel = bias_vl ? __fadd_rn(__fmul_rn(__fsub_rn(bias_vl[c], bias[c]), im), bias[c]) : bias[c];
+            const float sel = __fadd_rn(__fadd_rn(sc[i], bsel), rbias[c]);
+            const unsigned u = __float_as_uint(sel);
+            unsigned kv = (u & 0x80000000u) ? ~u : (u | 0x80000000u);   // unsigned order = float order
+            kv = ~kv;                                                    // descending
+            kk = ((unsigned long long) kv << 32) | (unsigned) c;
+        }
+        key[i] = kk;
+    }
+    unsigned long long best = ~0ull;
+#pragma unroll
+    for (int i = 0; i < NPL; ++i) {
+        best = key[i] < best ? key[i] : best;
+    }
+    int * ids_row = ids + (int64_t) row * k;
+    float mine = 0.0f;   // lane j < k: the j-th pick's score
+    for (int j = 0; j < k; ++j) {
+        unsigned long long m = best;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const unsigned long long o = __shfl_xor_sync(0xFFFFFFFFu, m, off);
+            m = o < m ? o : m;
+        }
+        const int col = (int) (m & 0xFFFFFFFFull);
+        if (lane == 0) {
+            ids_row[j] = col;
+        }
+        float v = 0.0f;
+        if (lane == (col & 31)) {   // the winner drops that column, rescans its own, and hands out its score
+            best = ~0ull;
+#pragma unroll
+            for (int i = 0; i < NPL; ++i) {
+                if (i == (col >> 5)) {
+                    key[i] = ~0ull;
+                    v = sc[i];
+                }
+                best = key[i] < best ? key[i] : best;
+            }
+        }
+        v = __shfl_sync(0xFFFFFFFFu, v, col & 31);
+        if (lane == j) {
+            mine = v;
+        }
+    }
+    if (wts) {
+        float w = mine;
+        if (norm) {
+            const float sum = warp_reduce_sum(mine);              // lanes >= k hold 0.0f, as reduce_rows_f32's
+            w = w / __fmaf_rn(1.0f, sum, 1e-20f);
+        }
+        w = __fmaf_rn(scale, w, 0.0f);
+        if (lane < k) {
+            wts[(int64_t) row * w_row + lane] = w;
+        }
+    }
+}
+
+void ggml_cuda_op_dsv4_route(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * logits = dst->src[0];
+    const ggml_tensor * bias   = dst->src[1];
+    const ggml_tensor * rbias  = dst->src[2];
+    const ggml_tensor * wts    = dst->src[3];
+    const ggml_tensor * bvl    = dst->src[4];   // ggml_dsv4_route_vl: the vision bias and the image mask (else null)
+    const ggml_tensor * img    = dst->src[5];
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && logits->nb[0] == sizeof(float));
+    GGML_ASSERT((bvl == nullptr) == (img == nullptr));
+    GGML_ASSERT(!bvl || (bvl->type == GGML_TYPE_F32 && img->type == GGML_TYPE_F32 && ggml_nelements(img) == ggml_nrows(logits)));
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && rbias->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_I32);
+    const int ne    = (int) logits->ne[0];
+    const int k     = ggml_get_op_params_i32(dst, 0);
+    const int norm  = ggml_get_op_params_i32(dst, 1);
+    const float scl = ggml_get_op_params_f32(dst, 2);
+    const int nrows = (int) ggml_nrows(logits);
+    GGML_ASSERT(k >= 1 && k <= 32 && ne <= 32 * 16);
+    const int64_t w_row = wts ? (int64_t) (wts->nb[1] / sizeof(float)) : 0;
+    const int rows_per_block = 4;
+    const dim3 blocks((nrows + rows_per_block - 1) / rows_per_block);
+    const dim3 threads(32 * rows_per_block);
+    cudaStream_t stream = ctx.stream();
+#define DSV4_ROUTE_NPL(N) \
+    if (ne <= 32 * (N)) { \
+        dsv4_route_f32<N><<<blocks, threads, 0, stream>>>((const float *) logits->data, (int64_t) (logits->nb[1] / sizeof(float)), \
+            (const float *) bias->data, (const float *) rbias->data, bvl ? (const float *) bvl->data : nullptr, \
+            img ? (const float *) img->data : nullptr, (int *) dst->data, wts ? (float *) wts->data : nullptr, \
+            w_row, ne, k, nrows, norm, scl); \
+        CUDA_CHECK(cudaGetLastError()); \
+        return; \
+    }
+    DSV4_ROUTE_NPL(1) DSV4_ROUTE_NPL(2) DSV4_ROUTE_NPL(4) DSV4_ROUTE_NPL(8) DSV4_ROUTE_NPL(16)
+#undef DSV4_ROUTE_NPL
+}

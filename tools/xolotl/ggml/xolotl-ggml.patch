+// mmvq.cu: the q8_1 image of src1 made by its producer in this evaluation, or null (then mul_mat_vec_q quantizes)
+const void * ggml_cuda_qfuse_lookup(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const int64_t ne10_padded) {
+    if (!ggml_cuda_qfuse_on()) {
+        return nullptr;
+    }
+    ggml_cuda_qfuse_state & qs = ggml_cuda_qfuse_state_of(&ctx);
+    if (!qs.active || ctx.curr_stream_no != 0) {
+        return nullptr;
+    }
+    for (const ggml_cuda_qfuse_image & im : qs.images) {

+static __device__ void quantize_f32_mxfp4_ds41_block(const float * __restrict__ x, block_mxfp4 * __restrict__ y) {
+    float amax = 0.0f;
+    for (int j = 0; j < QK_MXFP4; ++j) amax = fmaxf(amax, fabsf(x[j]));
+    int E = -127;                                            // scale 2^E, E8M0 byte E + 127
+    if (amax > 0.0f) {
+        int e; frexpf(amax, &e);                             // amax in [2^(e-1), 2^e): the floor rule's E = e - 3
+        bool found = false;

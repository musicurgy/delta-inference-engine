+
+struct ggml_cuda_qfuse_state {
+    bool active = false;
+    std::vector<ggml_cuda_qfuse_image> images;
+    std::vector<std::unique_ptr<ggml_cuda_pool_alloc<char>>> held;
+};
+
+static std::mutex g_qfuse_mutex;
+static std::unordered_map<const ggml_backend_cuda_context *, ggml_cuda_qfuse_state> g_qfuse_states;
+
+static ggml_cuda_qfuse_state & ggml_cuda_qfuse_state_of(const ggml_backend_cuda_context * ctx) {
+    std::lock_guard<std::mutex> lock(g_qfuse_mutex);

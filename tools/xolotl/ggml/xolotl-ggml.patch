+// ---------------------------------------------------------------- STRATA_QFUSE (Xolotl)
+// STRATA_QFUSE=1 (default off; CUDA only): an RMS_NORM + MUL pair whose output feeds MUL_MAT nodes that take
+// mul_mat_vec_q writes that output's q8_1 image in the same kernel (norm.cu rms_norm_mul_q8_1_f32: the same bytes as
+// quantize_q8_1), and every such consumer in the graph reads that image instead of launching its own quantize (one
+// image for all the consumers of the same activation: attn_q_a + attn_kv (+ compressor / indexer) on attn_norm's
+// output, the routers / predictors and shared expert on ffn_norm's, the head on output_norm's).  The images live in
+// the context's pool until the end of the graph's evaluation (released in reverse order: the VMM pool is a stack).
+// Off: no image is made, the lookup returns null before touching any state, every launch is as before.
+static std::atomic<int>     g_qfuse_mode{-1};   // -1: STRATA_QFUSE decides; 0 / 1: forced (test hook)
+static std::atomic<int64_t> g_qfuse_made{0};    // images written by a producer
+static std::atomic<int64_t> g_qfuse_hits{0};    // mul_mat_vec_q calls that read one (each = one quantize launch saved)
+
+static bool ggml_cuda_qfuse_on() {
